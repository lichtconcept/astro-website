---
// =============================================================================
// SectionHero – Vollbild-Slider (kavelle). Bilder: src/assets/, Texte: src/content/pages/.
// =============================================================================
import { Image } from 'astro:assets';
import { findImage } from '../lib/images';
import { site, type Landing } from '../lib/content';

interface Props {
  hero: Landing['hero'];
}

const { hero } = Astro.props;
const slides = hero.slides.map((s) => ({ ...s, ...findImage(s.image) }));
---

<section class="hero" aria-roledescription={site.labels.carousel} aria-label={hero.heading}>
  <h1 class="sr-only">{hero.heading}</h1>
  {
    slides.map((s, i) => (
      <article class:list={['slide', { on: i === 0 }]} aria-roledescription={site.labels.slide} aria-label={s.title} data-slide>
        <Image
          src={s.src}
          alt={s.alt}
          widths={[960, 1440, 1920]}
          sizes="100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
        />
        <div class="cap">
          <h2>{s.title}</h2>
          <a class="btn" href={hero.button.href}>{hero.button.label} <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </article>
    ))
  }
  <div class="bars" aria-hidden="true" data-bars>{slides.map(() => <i />)}</div>
  <div class="hero-ctl">
    <p class="count" aria-hidden="true"><b data-cur>01</b> / {String(slides.length).padStart(2, '0')}</p>
    <button type="button" aria-label={site.labels.previousSlide} data-prev>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
    </button>
    <button type="button" aria-label={site.labels.nextSlide} data-next>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
    </button>
  </div>
</section>
