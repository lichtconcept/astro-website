---
// =============================================================================
// BereichsHeader – gemeinsamer Aufbau für HeaderWeihnachten und HeaderWerbung.
//
// HIER NICHTS AN DEN MENÜPUNKTEN ÄNDERN! Die Menüpunkte stehen in
//   src/components/HeaderWeihnachten.astro bzw. HeaderWerbung.astro.
// Diese Datei enthält nur das Aussehen (HTML + Tailwind-Klassen), damit beide
// Header immer gleich aufgebaut sind.
//
// Desktop (ab 1280 px): Menü in einer Zeile.
// Mobil: Menü klappt über <details>/<summary> auf – ohne JavaScript.
// Der Wechsel-Button in den anderen Bereich ist immer sichtbar.
// =============================================================================
import { firma } from '../config/firma';

export interface MenuePunkt {
  text: string;
  href: string;
}

interface Props {
  /** Name des Bereichs im Badge, z. B. "Weihnachtsbeleuchtung" */
  bereichName: string;
  /** Kurzform für kleine Bildschirme, z. B. "Weihnachten" */
  bereichKurz: string;
  /** Startseite des Bereichs, z. B. "/weihnachtsbeleuchtung/" */
  startHref: string;
  menue: MenuePunkt[];
  /** Hervorgehobener Anfrage-Button */
  anfrage: MenuePunkt;
  /** Wechsel-Button in den anderen Bereich */
  wechsel: MenuePunkt & { kurz: string };
}

const { bereichName, bereichKurz, startHref, menue, anfrage, wechsel } = Astro.props;

// Aktuellen Pfad immer mit "/" am Ende vergleichen
const pfad = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const istAktiv = (href: string) => href === pfad;
---

<header class="sticky top-0 z-30 h-16 bg-grund text-white shadow-md">
  <div class="relative mx-auto flex h-full max-w-7xl items-center gap-2 px-4 sm:gap-3">
    <!-- Logo + Bereichs-Badge (Link auf die Bereichs-Startseite) -->
    <a href={startHref} class="flex shrink-0 items-center gap-2" aria-label={`${firma.kurzname} ${bereichName} – Übersicht`}>
      <img src="/favicon.svg" alt="" width="32" height="32" />
      <span class="hidden font-bold 2xl:inline">{firma.kurzname}</span>
      <span class="rounded-full bg-akzent px-2.5 py-0.5 text-xs font-semibold text-auf-akzent">
        <span class="sm:hidden">{bereichKurz}</span>
        <span class="hidden sm:inline">{bereichName}</span>
      </span>
    </a>

    <!-- Desktop-Navigation -->
    <nav aria-label={`Navigation ${bereichName}`} class="ml-auto hidden xl:block">
      <ul class="flex items-center gap-1 text-sm">
        {
          menue.map((punkt) => (
            <li>
              <a
                href={punkt.href}
                aria-current={istAktiv(punkt.href) ? 'page' : undefined}
                class="rounded-md px-3 py-2 transition-colors hover:text-akzent aria-[current=page]:text-akzent aria-[current=page]:underline aria-[current=page]:underline-offset-8"
              >
                {punkt.text}
              </a>
            </li>
          ))
        }
        <li class="ml-2">
          <a href={anfrage.href} class="btn-akzent py-2 text-sm whitespace-nowrap">{anfrage.text}</a>
        </li>
      </ul>
    </nav>

    <!-- Wechsel-Button (immer sichtbar, auch mobil) -->
    <a
      href={wechsel.href}
      class="ml-auto shrink-0 rounded-full border border-white/30 px-2.5 py-1.5 text-xs whitespace-nowrap text-white/85 transition-colors hover:border-white hover:text-white xl:ml-3"
    >
      <span class="sm:hidden">{wechsel.kurz}</span>
      <span class="hidden sm:inline">{wechsel.text}</span>
    </a>

    <!-- Mobile Navigation (ohne JavaScript) -->
    <details class="group xl:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-1 rounded-md border border-white/30 px-3 py-1.5 text-sm [&::-webkit-details-marker]:hidden"
      >
        <span aria-hidden="true" class="group-open:hidden">☰</span>
        <span aria-hidden="true" class="hidden group-open:inline">✕</span>
        <span class="sr-only sm:not-sr-only">Menü</span>
      </summary>
      <nav aria-label={`Navigation ${bereichName} (mobil)`} class="absolute inset-x-0 top-full bg-grund shadow-lg">
        <ul class="mx-auto flex max-w-7xl flex-col px-4 py-2">
          {
            menue.map((punkt) => (
              <li>
                <a
                  href={punkt.href}
                  aria-current={istAktiv(punkt.href) ? 'page' : undefined}
                  class="block border-b border-white/10 py-3 hover:text-akzent aria-[current=page]:font-semibold aria-[current=page]:text-akzent"
                >
                  {punkt.text}
                </a>
              </li>
            ))
          }
          <li class="py-3">
            <a href={anfrage.href} class="btn-akzent">{anfrage.text}</a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>
