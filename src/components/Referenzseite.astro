---
// =============================================================================
// Referenzseite – Seitenrumpf der Referenzen-Seiten beider Bereiche.
//
// NEUE BILDER: einfach in den Ordner src/assets/<bereich>/ legen (jpg, jpeg, png
// oder webp) UND in src/content/bilder.json einen Eintrag mit Alt-Text
// (und optional Unterschrift) ergänzen. Sortierung: nach Dateiname.
// =============================================================================
import ReferenzGalerie from './ReferenzGalerie.astro';
import { ordnerBilder } from '../lib/bilder';
import type { Referenzseite } from '../lib/content';

interface Props {
  inhalt: Referenzseite;
}

const { inhalt } = Astro.props;
---

<article class="page wide">
  <div class="page-in">
    <h1 data-in="down">{inhalt.title}</h1>
    <p class="lead-text" data-in="up">{inhalt.lead}</p>
  </div>
  <ReferenzGalerie bilder={ordnerBilder(inhalt.folder)} />
  <p class="section-cta">
    <a class="btn" href={inhalt.action.href}>{inhalt.action.label} <span class="arr" aria-hidden="true">→</span></a>
  </p>
</article>
