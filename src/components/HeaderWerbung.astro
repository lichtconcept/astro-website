---
// =============================================================================
// HeaderWerbung – Menü NUR für den Bereich Werbetechnik.
//
// >>> Menüpunkte hier ändern, ergänzen oder umsortieren. <<<
// "href" ist immer der Pfad der Seite MIT "/" am Ende.
// Das Aussehen steckt in BereichsHeader.astro (für beide Bereiche gleich).
// =============================================================================
import BereichsHeader from './BereichsHeader.astro';

const menue = [
  { text: 'Übersicht', href: '/werbetechnik/' },
  { text: 'Lichtwerbung', href: '/werbetechnik/lichtwerbung/' },
  { text: 'Fahrzeuge', href: '/werbetechnik/fahrzeugbeschriftung/' },
  { text: 'Referenzen', href: '/werbetechnik/referenzen/' },
];

// Hervorgehobener Button (öffnet die Kontaktseite mit Werbetechnik-Kontakt markiert)
const anfrage = { text: 'Projekt anfragen', href: '/kontakt/?bereich=werbetechnik' };

// Dezenter Button rechts: Wechsel in den anderen Bereich
const wechsel = { text: 'Zur Weihnachtsbeleuchtung ⇄', kurz: 'Weihnachten ⇄', href: '/weihnachtsbeleuchtung/' };
---

<BereichsHeader
  bereichName="Werbetechnik"
  bereichKurz="Werbetechnik"
  startHref="/werbetechnik/"
  menue={menue}
  anfrage={anfrage}
  wechsel={wechsel}
/>
