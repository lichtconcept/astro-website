---
// =============================================================================
// SectionGallery – Vorschau der Referenzen auf einer Bereichs-Startseite
// (die ersten Bilder eines Ordners aus src/assets/) als seitlich scrollbare
// Reihe mit Titel auf dem Bild (kavelle). Mit der Maus ziehbar (src/scripts/site.ts).
// Texte: src/content/pages/, Bildtitel: src/content/images.json ("label").
// =============================================================================
import { Image } from 'astro:assets';
import { folderImages } from '../lib/images';
import type { Landing } from '../lib/content';

interface Props {
  gallery: Landing['gallery'];
  index: number;
}

const { gallery, index } = Astro.props;
const preview = folderImages(gallery.folder).slice(0, gallery.count);
---

<section id={gallery.id} class:list={{ alt: index % 2 === 1 }} aria-labelledby={`${gallery.id}-h`}>
  <h2 id={`${gallery.id}-h`} class="h2" data-in="down">{gallery.heading}</h2>
  <ul class="row" data-drag-row>
    {
      preview.map((image) => (
        <li data-in="up">
          <a class="ph" href={gallery.link.href}>
            <Image src={image.src} alt={image.alt} widths={[600, 900, 1240]} sizes="(min-width: 780px) 620px, 80vw" loading="lazy" />
            {image.label && <span class="label">{image.label}</span>}
            <span class="arr" aria-hidden="true">→</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="section-cta" data-in="up"><a class="btn" href={gallery.link.href}>{gallery.link.label} <span class="arr" aria-hidden="true">→</span></a></p>
</section>
