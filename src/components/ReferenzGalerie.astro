---
// =============================================================================
// ReferenzGalerie – responsives Bilder-Raster mit Großansicht.
//
// Benutzung (siehe z. B. src/pages/weihnachtsbeleuchtung/referenzen.astro):
//   <ReferenzGalerie bilder={[{ src: importiertesBild, alt: '…', caption: '…' }]} />
//
// - Bilder werden von Astro automatisch verkleinert und als WebP ausgeliefert.
// - Klick auf ein Bild öffnet eine Großansicht (natives <dialog>-Element).
// - Ohne JavaScript öffnet der Klick einfach das große Bild.
// =============================================================================
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

export interface GalerieBild {
  /** Importiertes Bild aus src/assets/ */
  src: ImageMetadata;
  /** Beschreibung für Screenreader und Google (Pflicht) */
  alt: string;
  /** Optionale Bildunterschrift */
  caption?: string;
}

interface Props {
  bilder: GalerieBild[];
}

const { bilder } = Astro.props;

// Für jedes Bild zusätzlich eine große Version für die Großansicht erzeugen
const eintraege = await Promise.all(
  bilder.map(async (bild) => ({
    ...bild,
    gross: await getImage({ src: bild.src, width: 1920, format: 'webp' }),
  })),
);
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-galerie>
  {
    eintraege.map((bild) => (
      <figure class="overflow-hidden rounded-lg bg-slate-100 shadow-sm">
        <a href={bild.gross.src} data-gross={bild.gross.src} class="group block overflow-hidden">
          <Image
            src={bild.src}
            alt={bild.alt}
            widths={[400, 800, 1200]}
            sizes="(min-width: 1152px) 370px, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            loading="lazy"
            class="aspect-[3/2] w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        </a>
        {bild.caption && <figcaption class="px-3 py-2 text-sm text-slate-600">{bild.caption}</figcaption>}
      </figure>
    ))
  }
</div>

<!-- Großansicht -->
<dialog
  id="galerie-dialog"
  class="m-auto max-h-[95vh] max-w-[95vw] bg-transparent p-0 backdrop:bg-black/85"
  aria-label="Großansicht"
>
  <form method="dialog" class="text-right">
    <button class="mb-2 rounded-full bg-white/90 px-3 py-1 text-sm font-semibold text-slate-900 hover:bg-white">
      Schließen ✕
    </button>
  </form>
  <img alt="" class="max-h-[85vh] w-auto rounded" />
  <p class="mt-2 text-center text-sm text-white"></p>
</dialog>

<script>
  // Klick auf ein Galerie-Bild öffnet die Großansicht statt einer neuen Seite.
  const dialog = document.getElementById('galerie-dialog') as HTMLDialogElement | null;
  const grossBild = dialog?.querySelector('img');
  const text = dialog?.querySelector('p');

  document.querySelectorAll<HTMLAnchorElement>('[data-galerie] a[data-gross]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (!dialog || !grossBild || !text) return;
      event.preventDefault();
      const vorschau = link.querySelector('img');
      grossBild.src = link.dataset.gross ?? link.href;
      grossBild.alt = vorschau?.alt ?? '';
      text.textContent = link.parentElement?.querySelector('figcaption')?.textContent ?? '';
      dialog.showModal();
    });
  });

  // Klick auf den dunklen Hintergrund schließt die Großansicht
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
