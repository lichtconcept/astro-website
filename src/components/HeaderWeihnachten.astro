---
// =============================================================================
// HeaderWeihnachten – Menü NUR für den Bereich Weihnachtsbeleuchtung.
//
// >>> Menüpunkte hier ändern, ergänzen oder umsortieren. <<<
// "href" ist immer der Pfad der Seite MIT "/" am Ende.
// Das Aussehen steckt in BereichsHeader.astro (für beide Bereiche gleich).
// =============================================================================
import BereichsHeader from './BereichsHeader.astro';

const menue = [
  { text: 'Übersicht', href: '/weihnachtsbeleuchtung/' },
  { text: 'Städte & Kommunen', href: '/weihnachtsbeleuchtung/staedte-kommunen/' },
  { text: 'Gewerbe', href: '/weihnachtsbeleuchtung/gewerbe/' },
  { text: 'Referenzen', href: '/weihnachtsbeleuchtung/referenzen/' },
];

// Hervorgehobener Button (öffnet die Kontaktseite mit Weihnachts-Kontakt markiert)
const anfrage = { text: 'Anfrage stellen', href: '/kontakt/?bereich=weihnachten' };

// Dezenter Button rechts: Wechsel in den anderen Bereich
const wechsel = { text: 'Zur Werbetechnik ⇄', kurz: 'Werbetechnik ⇄', href: '/werbetechnik/' };
---

<BereichsHeader
  bereichName="Weihnachtsbeleuchtung"
  bereichKurz="Weihnachten"
  startHref="/weihnachtsbeleuchtung/"
  menue={menue}
  anfrage={anfrage}
  wechsel={wechsel}
/>
