---
// =============================================================================
// Footer – gemeinsamer Fuß für alle Seiten (außer der Startseite).
// Texte und Links: src/content/site.json → "footer". Firmendaten: src/config/company.ts.
// =============================================================================
import { company, telHref } from '../config/company';
import { site } from '../lib/content';
import SocialLinks from './SocialLinks.astro';

const footer = site.footer;
---

<footer class="site-footer">
  <div class="f-grid">
    <div>
      <a class="logo" href="/" aria-label={site.navigation.neutral.homeLabel}>
        <img src="/favicon.svg" alt="" width="34" height="34" />
        <span class="name">{company.shortName}</span>
      </a>
      <p class="f-about">{footer.about}</p>
    </div>

    <nav aria-label={footer.areasLabel}>
      <h2>{footer.areasHeading}</h2>
      <ul>{footer.areas.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    <nav aria-label={footer.infoLabel}>
      <h2>{footer.infoHeading}</h2>
      <ul>{footer.info.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    <div class="f-contact">
      <h2>{footer.contactHeading}</h2>
      <address>
        {company.name}<br />
        {company.address.street}<br />
        {company.address.zip} {company.address.city}
      </address>
      <a class="tel" href={telHref(company.phone)}>{footer.phonePrefix} {company.phone}</a>
      <a href={`mailto:${company.email}`}>{company.email}</a>
      <SocialLinks />
    </div>
  </div>
  <p class="f-bottom">{footer.copyright}</p>
</footer>
