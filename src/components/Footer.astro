---
// =============================================================================
// Footer – gemeinsamer Fuß für alle Seiten (außer der Startseite).
// Firmendaten kommen aus src/config/firma.ts.
// =============================================================================
import { firma, telLink } from '../config/firma';

const bereichsLinks = [
  { text: 'Weihnachtsbeleuchtung', href: '/weihnachtsbeleuchtung/' },
  { text: 'Werbetechnik', href: '/werbetechnik/' },
];

const infoLinks = [
  { text: 'Über uns', href: '/ueber-uns/' },
  { text: 'Kontakt', href: '/kontakt/' },
  { text: 'Impressum', href: '/impressum/' },
  { text: 'Datenschutz', href: '/datenschutz/' },
];

const jahr = new Date().getFullYear();
---

<footer class="bg-grund text-sm text-white/80">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-3">
    <div>
      <p class="mb-2 font-semibold text-white">{firma.name}</p>
      <address class="not-italic leading-relaxed">
        {firma.adresse.strasse}<br />
        {firma.adresse.plz} {firma.adresse.ort}<br />
        Tel. <a href={telLink(firma.telefon)} class="hover:text-akzent">{firma.telefon}</a><br />
        <a href={`mailto:${firma.email}`} class="hover:text-akzent">{firma.email}</a>
      </address>
    </div>

    <nav aria-label="Bereiche">
      <p class="mb-2 font-semibold text-white">Unsere Bereiche</p>
      <ul class="space-y-1">
        {bereichsLinks.map((l) => <li><a href={l.href} class="hover:text-akzent">{l.text}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Informationen">
      <p class="mb-2 font-semibold text-white">Informationen</p>
      <ul class="space-y-1">
        {infoLinks.map((l) => <li><a href={l.href} class="hover:text-akzent">{l.text}</a></li>)}
      </ul>
    </nav>
  </div>
  <p class="border-t border-white/10 py-4 text-center text-xs text-white/60">© {jahr} {firma.name}</p>
</footer>
