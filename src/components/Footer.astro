---
// =============================================================================
// Footer – gemeinsamer Fuß für alle Seiten (außer der Startseite).
// Texte und Links: src/content/site.json → "footer". Firmendaten: src/config/firma.ts.
// =============================================================================
import { firma, telLink } from '../config/firma';
import { site } from '../lib/content';

const f = site.footer;
---

<footer class="site-footer">
  <div class="f-grid">
    <div>
      <a class="logo" href="/" aria-label={site.navigation.neutral.homeLabel.replace('{kurzname}', firma.kurzname)}>
        <img src="/favicon.svg" alt="" width="34" height="34" />
        <span class="name">{firma.kurzname}</span>
      </a>
      <p class="f-about">{f.about}</p>
    </div>

    <nav aria-label={f.areasLabel}>
      <h2>{f.areasHeading}</h2>
      <ul>{f.areas.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    <nav aria-label={f.infoLabel}>
      <h2>{f.infoHeading}</h2>
      <ul>{f.info.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>

    <div class="f-contact">
      <h2>{f.contactHeading}</h2>
      <address>
        {firma.name}<br />
        {firma.adresse.strasse}<br />
        {firma.adresse.plz} {firma.adresse.ort}
      </address>
      <a class="tel" href={telLink(firma.telefon)}>{f.phonePrefix} {firma.telefon}</a>
      <a href={`mailto:${firma.email}`}>{firma.email}</a>
    </div>
  </div>
  <p class="f-bottom">{f.copyright}</p>
</footer>
