---
// =============================================================================
// SiteHeader – Kopfzeile aller Seiten (außer der Startseite).
// Aussehen: kavelle (Logo mittig, Menü links und rechts, Burger auf dem Handy).
// Menüpunkte, Buttons und Beschriftungen: src/content/site.json → "navigation".
// =============================================================================
import { company } from '../config/company';
import { site, type Area } from '../lib/content';

interface Props {
  area?: Area;
  /** Kopfzeile von Anfang an dunkel (für Seiten mit hellem Hintergrund, z. B. Kontakt) */
  solid?: boolean;
}

const { area, solid = false } = Astro.props;
const nav = site.navigation[area ?? 'neutral'];

// Menü in zwei Hälften teilen: links und rechts vom Logo
const middle = Math.ceil(nav.menu.length / 2);
const leftItems = nav.menu.slice(0, middle);
const rightItems = nav.menu.slice(middle);

// Aktuellen Pfad immer mit "/" am Ende vergleichen
const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const ariaCurrent = (href: string) => (href === currentPath ? 'page' : undefined);
---

<header class:list={['top-bar', { always: solid }]} data-top-bar>
  <nav class="nav-l" aria-label={nav.navLabel}>
    {leftItems.map((p) => <a href={p.href} aria-current={ariaCurrent(p.href)}>{p.label}</a>)}
  </nav>

  <a class="logo" href={nav.home} aria-label={nav.homeLabel}>
    <img src="/favicon.svg" alt="" width="34" height="34" />
    <span>
      <span class="name">{company.shortName}</span>
      {nav.badge && <span class="badge">{nav.badge}</span>}
    </span>
  </a>

  <div class="right">
    <nav class="nav-r" aria-label={nav.navLabelMore}>
      {rightItems.map((p) => <a href={p.href} aria-current={ariaCurrent(p.href)}>{p.label}</a>)}
    </nav>
    {nav.cta && <a href={nav.cta.href} class="btn cta">{nav.cta.label}</a>}
    {nav.switch && <a href={nav.switch.href} class="switch"><span>{nav.switch.label}</span></a>}
    <button class="burger" type="button" aria-label={site.labels.menu} aria-expanded="false" data-burger>
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8h18M3 16h18" /></svg>
    </button>
  </div>
</header>

<!-- Menü für Handy und Tablet (wird per Burger-Button geöffnet) -->
<nav class="panel" aria-label={nav.navLabelMobile} data-panel>
  <ul>
    {nav.menu.map((p) => <li><a href={p.href} aria-current={ariaCurrent(p.href)}>{p.label}</a></li>)}
  </ul>
  {nav.cta && <a href={nav.cta.href} class="btn">{nav.cta.label}</a>}
  {nav.switch && <a href={nav.switch.href} class="switch"><span>{nav.switch.label}</span></a>}
</nav>
