---
// =============================================================================
// SectionText – ein Abschnitt einer Bereichs-Startseite (Überschrift, Text,
// optional Liste, Link, Bild oder Karten zu Unterseiten). Aussehen: kavelle.
// Der Parameter "index" lässt Bild und Text abwechselnd die Seite tauschen.
// =============================================================================
import { Image } from 'astro:assets';
import { findImage } from '../lib/images';
import { site, type Section } from '../lib/content';

interface Props {
  section: Section;
  index: number;
}

const { section, index } = Astro.props;
const mainImage = section.image ? findImage(section.image) : undefined;
const cards = (section.cards ?? []).map((card) => ({ ...card, ...findImage(card.image) }));
---

<section id={section.id} class:list={{ alt: index % 2 === 1 }} aria-labelledby={`${section.id}-h`}>
  {
    mainImage ? (
      <div class:list={['split', { flip: index % 2 === 1 }]}>
        <div class="split-txt" data-in={index % 2 === 1 ? 'right' : 'left'}>
          <h2 id={`${section.id}-h`} class="split-h">{section.heading}</h2>
          <p>{section.text}</p>
          {section.list && <ul>{section.list.map((item) => <li>{item}</li>)}</ul>}
          {section.link && <a class="btn" href={section.link.href}>{section.link.label} <span class="arr" aria-hidden="true">→</span></a>}
        </div>
        <div class="ph" data-in={index % 2 === 1 ? 'left' : 'right'}>
          <Image src={mainImage.src} alt={mainImage.alt} widths={[600, 900, 1200]} sizes="(min-width: 1100px) 45vw, 100vw" loading="lazy" />
        </div>
      </div>
    ) : (
      <div class="sec-head">
        <h2 id={`${section.id}-h`} class="h2" data-in="down">{section.heading}</h2>
        <p data-in="up">{section.text}</p>
      </div>
    )
  }
  {
    cards.length > 0 && (
      <div class="svc">
        {cards.map((card, i) => (
          <a href={card.href} data-in="up" style={`transition-delay:${i * 0.12}s`}>
            <div class="top">
              <span class="more">
                {site.labels.more}
                <svg viewBox="0 0 54 54" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M8 46 46 8M18 8h28v28" /></svg>
              </span>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </div>
            <div class="ph">
              <Image src={card.src} alt={card.alt} widths={[400, 800]} sizes="(min-width: 1100px) 30vw, 100vw" loading="lazy" />
            </div>
          </a>
        ))}
      </div>
    )
  }
</section>
