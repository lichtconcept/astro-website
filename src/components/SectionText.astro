---
// =============================================================================
// SectionText – ein Abschnitt einer Bereichs-Startseite (Überschrift, Text,
// optional Liste, Link, Bild oder Karten zu Unterseiten). Aussehen: kavelle.
// Der Parameter "index" lässt Bild und Text abwechselnd die Seite tauschen.
// =============================================================================
import { Image } from 'astro:assets';
import { bild } from '../lib/bilder';
import { site, type Abschnitt } from '../lib/content';

interface Props {
  abschnitt: Abschnitt;
  index: number;
}

const { abschnitt: a, index } = Astro.props;
const hauptbild = a.image ? bild(a.image) : undefined;
const karten = (a.cards ?? []).map((k) => ({ ...k, ...bild(k.image) }));
---

<section id={a.id} class:list={{ alt: index % 2 === 1 }} aria-labelledby={`${a.id}-h`}>
  {
    hauptbild ? (
      <div class:list={['split', { flip: index % 2 === 1 }]}>
        <div class="split-txt" data-in={index % 2 === 1 ? 'right' : 'left'}>
          <h2 id={`${a.id}-h`} class="split-h">{a.heading}</h2>
          <p>{a.text}</p>
          {a.list && <ul>{a.list.map((punkt) => <li>{punkt}</li>)}</ul>}
          {a.link && <a class="btn" href={a.link.href}>{a.link.label} <span class="arr" aria-hidden="true">→</span></a>}
        </div>
        <div class="ph" data-in={index % 2 === 1 ? 'left' : 'right'}>
          <Image src={hauptbild.src} alt={hauptbild.alt} widths={[600, 900, 1200]} sizes="(min-width: 1100px) 45vw, 100vw" loading="lazy" />
        </div>
      </div>
    ) : (
      <div class="sec-head">
        <h2 id={`${a.id}-h`} class="h2" data-in="down">{a.heading}</h2>
        <p data-in="up">{a.text}</p>
      </div>
    )
  }
  {
    karten.length > 0 && (
      <div class="svc">
        {karten.map((k, i) => (
          <a href={k.href} data-in="up" style={`transition-delay:${i * 0.12}s`}>
            <div class="top">
              <span class="more">
                {site.labels.more}
                <svg viewBox="0 0 54 54" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M8 46 46 8M18 8h28v28" /></svg>
              </span>
              <h3>{k.title}</h3>
              <p>{k.text}</p>
            </div>
            <div class="ph">
              <Image src={k.src} alt={k.alt} widths={[400, 800]} sizes="(min-width: 1100px) 30vw, 100vw" loading="lazy" />
            </div>
          </a>
        ))}
      </div>
    )
  }
</section>
