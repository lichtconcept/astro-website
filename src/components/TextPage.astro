---
// =============================================================================
// TextPage – Seitenrumpf für Unterseiten, Über uns, Impressum, Datenschutz, 404.
// Alle Inhalte kommen als Objekt aus src/content/ (Typ "TextPageContent" in src/lib/content.ts):
//   title, lead, sections[{ heading, paragraphs, lines, list, linkList }], actions[]
// =============================================================================
import type { TextPageContent } from '../lib/content';

interface Props {
  content: TextPageContent;
  /** Überschrift und Buttons zentrieren (z. B. 404) */
  centered?: boolean;
}

const { content, centered = false } = Astro.props;
---

<article class:list={['page', { center: centered }]}>
  <div class="page-in">
    <h1 data-in="down">{content.title}</h1>
    {content.lead && <p class="lead-text" data-in="up">{content.lead}</p>}

    <!-- Platz für zusätzliche Blöcke zwischen Einleitung und Abschnitten -->
    <slot />

    {
      content.sections?.map((s) => (
        <section class="page-sec">
          <h2>{s.heading}</h2>
          {s.paragraphs?.map((p) => <p>{p}</p>)}
          {s.lines && <p>{s.lines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}</p>}
          {s.list && <ul>{s.list.map((item) => <li>{item}</li>)}</ul>}
          {s.linkList && (
            <ul>
              {s.linkList.map((l) => (
                <li><a href={l.href}>{l.label}</a>{' '}{l.text}</li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    {
      content.actions && (
        <p class="actions">
          {content.actions.map((a) =>
            a.style === 'link' ? (
              <a href={a.href}>{a.label}</a>
            ) : (
              <a class="btn" href={a.href}>{a.label} <span class="arr" aria-hidden="true">→</span></a>
            ),
          )}
        </p>
      )
    }
  </div>
</article>
