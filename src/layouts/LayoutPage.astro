---
// =============================================================================
// LayoutPage – Layout für alle Seiten mit Kopfzeile und Fußzeile.
//   area="weihnachten" → Seiten unter /weihnachtsbeleuchtung/ (Gold auf Nachtblau)
//   area="werbetechnik"   → Seiten unter /werbetechnik/ (Himmelblau auf Anthrazit)
//   ohne area        → gemeinsame Seiten (Über uns, Kontakt, Impressum, Datenschutz, 404)
// Menüs und Beschriftungen stehen in src/content/site.json.
// =============================================================================
import LayoutBase from './LayoutBase.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import type { Area, Seo } from '../lib/content';

interface Props {
  seo: Seo;
  area?: Area;
}

const { seo, area } = Astro.props;
---

<LayoutBase seo={seo} area={area}>
  <slot name="head" slot="head" />
  <SiteHeader area={area} />
  <main>
    <slot />
  </main>
  <Footer />
</LayoutBase>
