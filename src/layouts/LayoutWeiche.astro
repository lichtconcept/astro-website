---
// =============================================================================
// LayoutWeiche – Minimal-Layout für die Startseite (Split-Screen-Weiche).
// Kein Bereichs-Header, nur der Seiteninhalt + ein fixierter Mini-Footer.
// =============================================================================
import LayoutBase from './LayoutBase.astro';
import { site, type Seo } from '../lib/content';

interface Props {
  seo: Seo;
}

const { seo } = Astro.props;
---

<LayoutBase seo={seo}>
  <slot name="head" slot="head" />

  <main>
    <slot />
  </main>

  <footer class="start-foot">
    <nav aria-label={site.startFooter.label}>
      <ul>
        {site.startFooter.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
  </footer>
</LayoutBase>
