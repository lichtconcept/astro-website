---
// =============================================================================
// LayoutSeite – Layout für alle Seiten mit Kopfzeile und Fußzeile.
//   bereich="weihnachten"  → Seiten unter /weihnachtsbeleuchtung/ (Gold auf Nachtblau)
//   bereich="werbetechnik" → Seiten unter /werbetechnik/ (Himmelblau auf Anthrazit)
//   ohne bereich           → gemeinsame Seiten (Über uns, Kontakt, Impressum, Datenschutz, 404)
// Menüs und Beschriftungen stehen in src/content/site.json.
// =============================================================================
import LayoutBase from './LayoutBase.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import type { Seo } from '../lib/content';

interface Props {
  seo: Seo;
  bereich?: 'weihnachten' | 'werbetechnik';
  /** Kopfzeile von Anfang an dunkel (Seiten mit hellem Hintergrund) */
  kopfDunkel?: boolean;
}

const { seo, bereich, kopfDunkel = false } = Astro.props;
---

<LayoutBase seo={seo} bereich={bereich}>
  <slot name="head" slot="head" />
  <SiteHeader bereich={bereich} dunkel={kopfDunkel} />
  <main>
    <slot />
  </main>
  <Footer />
</LayoutBase>
