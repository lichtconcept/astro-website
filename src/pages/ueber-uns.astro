---
// Über uns. Inhalte: src/content/pages/allgemein.json → "ueberUns".
import LayoutSeite from '../layouts/LayoutSeite.astro';
import Textseite from '../components/Textseite.astro';
import { allgemein } from '../lib/content';
import { localBusinessJsonLd } from '../config/firma';

const jsonLd = JSON.stringify(localBusinessJsonLd(Astro.site));
---

<LayoutSeite seo={allgemein.ueberUns.seo}>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />
  <Textseite inhalt={allgemein.ueberUns} />
</LayoutSeite>
