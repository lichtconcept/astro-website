---
// =============================================================================
// Weihnachtsbeleuchtung – Referenzen
//
// NEUE BILDER: einfach in den Ordner src/assets/weihnachten/ legen
// (jpg, jpeg, png oder webp). Sie erscheinen automatisch in der Galerie,
// sortiert nach Dateiname. Der Alt-Text wird aus dem Dateinamen erzeugt.
//
// Optional: eigenen Alt-Text oder eine Bildunterschrift festlegen.
// Schlüssel = Dateiname OHNE Endung.
// =============================================================================
import type { ImageMetadata } from 'astro';
import LayoutWeihnachten from '../../layouts/LayoutWeihnachten.astro';
import ReferenzGalerie from '../../components/ReferenzGalerie.astro';
import { galerieAusOrdner, type BildTexte } from '../../lib/galerie';

const texte: BildTexte = {
  'marktplatz-weihnachtsbaum': {
    alt: 'Beleuchteter Weihnachtsbaum auf dem Marktplatz',
    caption: 'Platzhalter: Marktplatz Musterstadt, 2025',
  },
  'lichterketten-fussgaengerzone': { caption: 'Platzhalter: Fußgängerzone Beispielort' },
};

const bilder = galerieAusOrdner(
  import.meta.glob<{ default: ImageMetadata }>('/src/assets/weihnachten/*.{jpg,jpeg,png,webp}', { eager: true }),
  texte,
);
---

<LayoutWeihnachten
  title="Referenzen Weihnachtsbeleuchtung"
  description="Ausgewählte Projekte unserer Weihnachtsbeleuchtung für Städte, Kommunen und Gewerbe – Bildergalerie mit Beispielen."
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <h1 class="mb-4 text-2xl font-bold tracking-tight text-slate-900 sm:text-4xl">Referenzen Weihnachtsbeleuchtung</h1>
    <p class="mb-8 max-w-3xl text-slate-700">
      Platzhaltertext: Eine Auswahl unserer Projekte. Klicken Sie auf ein Bild für die Großansicht.
    </p>

    <ReferenzGalerie bilder={bilder} />

    <p class="mt-10">
      <a href="/kontakt/?bereich=weihnachten" class="btn-akzent">Ihr Projekt anfragen →</a>
    </p>
  </div>
</LayoutWeihnachten>
