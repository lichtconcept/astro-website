---
// =============================================================================
// Kontakt
// Zwei Kontaktblöcke (je Bereich). Kommt man über einen Anfrage-Button
// (z. B. /kontakt/?bereich=weihnachten), wird der passende Block hervorgehoben.
// Texte: src/content/pages/allgemein.json → "kontakt". Kontaktdaten: src/config/firma.ts.
// =============================================================================
import LayoutSeite from '../layouts/LayoutSeite.astro';
import { firma, telLink } from '../config/firma';
import { allgemein } from '../lib/content';

const k = allgemein.kontakt;
const bloecke = k.blocks.map((b) => ({ ...b, ...firma[b.id] }));
---

<LayoutSeite seo={k.seo} kopfDunkel>
  <article class="contact">
    <h1 data-in="down">{k.title}</h1>
    <p class="lead" data-in="up">{k.lead}</p>

    <div class="cards">
      {
        bloecke.map((b) => (
          <section id={b.id} data-bereich={b.id} data-kontakt-block class="card" data-in="up">
            <p class="eyebrow">{k.labels.area}</p>
            <h2>{b.titel}</h2>
            <dl>
              <dt>{k.labels.person}</dt>
              <dd>{b.ansprechpartner}</dd>
              <dt>{k.labels.phone}</dt>
              <dd><a href={telLink(b.telefon)}>{b.telefon}</a></dd>
              <dt>{k.labels.email}</dt>
              <dd><a href={`mailto:${b.email}`}>{b.email}</a></dd>
            </dl>
            <a href={`mailto:${b.email}?subject=${encodeURIComponent(b.subject)}`} class="btn">
              {k.labels.write} <span class="arr" aria-hidden="true">→</span>
            </a>
          </section>
        ))
      }
    </div>

    <p class="general">
      {k.labels.general}: {firma.name}, {firma.adresse.strasse}, {firma.adresse.plz} {firma.adresse.ort} · {k.labels.phoneShort}{' '}
      <a href={telLink(firma.telefon)}>{firma.telefon}</a>
    </p>
  </article>

  <!-- Passenden Kontaktblock hervorheben, z. B. bei /kontakt/?bereich=werbetechnik -->
  <script is:inline>
    (function () {
      var bereich = new URLSearchParams(window.location.search).get('bereich');
      if (!bereich) return;
      var block = document.querySelector('[data-kontakt-block][data-bereich="' + CSS.escape(bereich) + '"]');
      if (!block) return;
      block.setAttribute('data-hervorgehoben', '');
      block.scrollIntoView({ block: 'nearest' });
    })();
  </script>
</LayoutSeite>
