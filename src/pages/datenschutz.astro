---
// Datenschutzerklärung – PLATZHALTER! Muss durch die rechtlich geprüfte Erklärung ersetzt werden.
import LayoutNeutral from '../layouts/LayoutNeutral.astro';
import { firma } from '../config/firma';
---

<LayoutNeutral title="Datenschutzerklärung" description={`Informationen zum Datenschutz und zur Verarbeitung personenbezogener Daten bei ${firma.name}.`}>
  <article class="inhalt">
    <h1>Datenschutzerklärung</h1>
    <p><strong>Platzhalter – bitte durch die rechtlich geprüfte Datenschutzerklärung ersetzen.</strong></p>

    <h2>Verantwortlicher</h2>
    <p>
      {firma.name}, {firma.adresse.strasse}, {firma.adresse.plz} {firma.adresse.ort}<br />
      E-Mail: {firma.email}
    </p>

    <h2>Hosting und Server-Logfiles</h2>
    <p>Platzhaltertext: Angaben zum Hosting und zu den vom Webserver gespeicherten Zugriffsdaten.</p>

    <h2>Keine externen Dienste</h2>
    <p>
      Platzhaltertext: Diese Website lädt keine Schriften, Skripte oder Inhalte von Drittanbietern und setzt keine
      Cookies.
    </p>

    <h2>Kontaktaufnahme per E-Mail oder Telefon</h2>
    <p>Platzhaltertext: Verarbeitung Ihrer Angaben zur Bearbeitung der Anfrage.</p>

    <h2>Ihre Rechte</h2>
    <p>Platzhaltertext: Auskunft, Berichtigung, Löschung, Einschränkung, Widerspruch, Datenübertragbarkeit, Beschwerde.</p>
  </article>
</LayoutNeutral>
