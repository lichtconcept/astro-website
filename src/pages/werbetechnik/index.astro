---
// =============================================================================
// Werbetechnik – Hauptseite
// Alle wichtigen Leistungen untereinander. Das Sub-Menü springt per Anker
// (#lichtwerbung, #fahrzeuge, …) zu den Abschnitten. Die "id" eines Abschnitts
// muss zum "href" im Sub-Menü passen.
// =============================================================================
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import LayoutWerbung from '../../layouts/LayoutWerbung.astro';
import { galerieAusOrdner } from '../../lib/galerie';

// Sub-Menü (Anker-Navigation)
const subMenue = [
  { text: 'Lichtwerbung', href: '#lichtwerbung' },
  { text: 'Fahrzeuge', href: '#fahrzeuge' },
  { text: 'Beschilderung', href: '#beschilderung' },
  { text: 'Referenzen', href: '#referenzen' },
];

// Vorschau: die ersten 3 Bilder aus src/assets/werbetechnik/
const vorschau = galerieAusOrdner(
  import.meta.glob<{ default: ImageMetadata }>('/src/assets/werbetechnik/*.{jpg,jpeg,png,webp}', { eager: true }),
).slice(0, 3);

const kontakt = '/kontakt/?bereich=werbetechnik';
---

<LayoutWerbung
  title="Werbetechnik: Lichtwerbung, Fahrzeugbeschriftung & Beschilderung"
  description="Werbetechnik aus einer Hand: Leuchtreklame, Fahrzeugbeschriftung, Schilder und Beschriftungen – von der Gestaltung bis zur Montage."
>
  <!-- Einstieg -->
  <section class="bg-grund text-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
      <p class="mb-2 text-sm font-semibold tracking-widest text-akzent uppercase">Werbetechnik</p>
      <h1 class="mb-4 max-w-3xl text-3xl font-bold sm:text-5xl">Werbung, die Tag und Nacht für Sie arbeitet</h1>
      <p class="mb-8 max-w-2xl text-lg text-white/80">
        Platzhaltertext: Von der Leuchtreklame über die Fahrzeugbeschriftung bis zum Bauschild – wir gestalten,
        produzieren und montieren.
      </p>
      <a href={kontakt} class="btn-akzent">Projekt anfragen →</a>
    </div>
  </section>

  <!-- Sticky Sub-Menü (klebt unter dem Header) -->
  <nav aria-label="Abschnitte dieser Seite" class="sticky top-16 z-20 border-b border-white/10 bg-grund-hell text-white">
    <ul class="mx-auto flex max-w-6xl gap-1 overflow-x-auto px-4 text-sm whitespace-nowrap">
      {
        subMenue.map((p) => (
          <li>
            <a href={p.href} class="block px-3 py-3 transition-colors hover:text-akzent">
              {p.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- Abschnitt: Lichtwerbung -->
  <section id="lichtwerbung" class="mx-auto max-w-6xl px-4 py-14">
    <h2 class="mb-3 text-2xl font-bold text-slate-900 sm:text-3xl">Lichtwerbung</h2>
    <p class="mb-6 max-w-3xl leading-relaxed text-slate-700">
      Platzhaltertext: Leuchtbuchstaben, Leuchtkästen und Pylone in LED-Technik – energiesparend, langlebig und
      auch nachts gut sichtbar.
    </p>
    <a href="/werbetechnik/lichtwerbung/" class="font-semibold text-slate-900 underline decoration-akzent decoration-2 underline-offset-4 hover:text-slate-600">Mehr zur Lichtwerbung →</a>
  </section>

  <!-- Abschnitt: Fahrzeuge -->
  <section id="fahrzeuge" class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="mb-3 text-2xl font-bold text-slate-900 sm:text-3xl">Fahrzeugbeschriftung</h2>
      <p class="mb-6 max-w-3xl leading-relaxed text-slate-700">
        Platzhaltertext: Vom einzelnen Firmenwagen bis zur ganzen Flotte – Teil- oder Vollfolierung, passgenau
        verklebt.
      </p>
      <a href="/werbetechnik/fahrzeugbeschriftung/" class="font-semibold text-slate-900 underline decoration-akzent decoration-2 underline-offset-4 hover:text-slate-600">Mehr zur Fahrzeugbeschriftung →</a>
    </div>
  </section>

  <!-- Abschnitt: Beschilderung (noch ohne eigene Detailseite) -->
  <section id="beschilderung" class="mx-auto max-w-6xl px-4 py-14">
    <h2 class="mb-3 text-2xl font-bold text-slate-900 sm:text-3xl">Beschilderung</h2>
    <p class="mb-4 max-w-3xl leading-relaxed text-slate-700">
      Platzhaltertext: Firmenschilder, Bauschilder, Leitsysteme und Schaufensterbeschriftungen – individuell
      gestaltet und fachgerecht montiert.
    </p>
    <ul class="mb-6 list-disc space-y-1 pl-6 text-slate-700">
      <li>Platzhalter: Firmen- und Praxisschilder</li>
      <li>Platzhalter: Bau- und Werbeschilder</li>
      <li>Platzhalter: Schaufenster- und Glasdekor</li>
    </ul>
    <a href={kontakt} class="font-semibold text-slate-900 underline decoration-akzent decoration-2 underline-offset-4 hover:text-slate-600">Beschilderung anfragen →</a>
  </section>

  <!-- Abschnitt: Referenzen (Vorschau) -->
  <section id="referenzen" class="bg-grund text-white">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="mb-6 text-2xl font-bold sm:text-3xl">Referenzen</h2>
      <div class="mb-6 grid gap-4 sm:grid-cols-3">
        {
          vorschau.map((bild) => (
            <Image
              src={bild.src}
              alt={bild.alt}
              widths={[400, 800]}
              sizes="(min-width: 1152px) 370px, (min-width: 640px) 33vw, 100vw"
              loading="lazy"
              class="aspect-[3/2] w-full rounded-lg object-cover"
            />
          ))
        }
      </div>
      <a href="/werbetechnik/referenzen/" class="btn-akzent">Alle Referenzen ansehen →</a>
    </div>
  </section>
</LayoutWerbung>
